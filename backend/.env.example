# RecipeHub backend - plantilla de configuracion (sin secretos)
NODE_ENV=development
PORT=3000

# Base de datos (usar 127.0.0.1, no localhost)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=recipehub_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=recipehub
DB_SSL=false
# Certificado CA (formato PEM) de una base de datos remota con TLS, como Aiven.
# Solo con DB_SSL=true. Dejar vacio en local. Nunca subir el certificado a Git.
DB_SSL_CA=
DB_CONNECTION_LIMIT=10

# Proxies de confianza delante de la API: 0 en local, 1 en Render
TRUST_PROXY=0

# Origenes permitidos por CORS, separados por comas, sin barra final
CORS_ORIGINS=http://localhost:4200

# true = la API rechaza POST, PUT y DELETE (demo publica)
READ_ONLY_DEMO=false

# Limite de peticiones por IP: ventana en milisegundos (15 min) y maximo
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Limite adicional para escrituras (POST, PUT y DELETE) en la misma ventana
WRITE_RATE_LIMIT_MAX=20